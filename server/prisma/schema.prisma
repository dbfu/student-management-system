generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  password  String   @db.VarChar(255)
  name      String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model College {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  majors    Major[]
  teachers  Teacher[]
  classes   Class[]

  @@map("colleges")
}

model Major {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  collegeId Int      @map("college_id")
  college   College  @relation(fields: [collegeId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  classes   Class[]

  @@unique([name, collegeId])
  @@map("majors")
}

model Class {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(100)
  collegeId   Int      @map("college_id")
  majorId     Int      @map("major_id")
  grade       Int
  teacherId   Int?     @map("teacher_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  college     College   @relation(fields: [collegeId], references: [id])
  major       Major     @relation(fields: [majorId], references: [id])
  teacher     Teacher?  @relation(fields: [teacherId], references: [id])
  students    Student[]
  courses     CourseClass[]

  @@map("classes")
}

model Teacher {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(50)
  gender      String   @db.VarChar(10)
  phone       String?  @db.VarChar(20)
  email       String?  @db.VarChar(100)
  collegeId   Int      @map("college_id")
  title       String?  @db.VarChar(50)
  status      String   @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  college     College        @relation(fields: [collegeId], references: [id])
  classes     Class[]
  courses     CourseTeacher[]

  @@map("teachers")
}

model Student {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(20)
  name          String   @db.VarChar(50)
  gender        String   @db.VarChar(10)
  birthDate     DateTime? @map("birth_date") @db.Date
  phone         String?  @db.VarChar(20)
  email         String?  @db.VarChar(100)
  classId       Int      @map("class_id")
  enrollYear    Int      @map("enroll_year")
  status        String   @db.VarChar(20)
  address       String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  class         Class          @relation(fields: [classId], references: [id])
  grades        Grade[]
  attendances   Attendance[]

  @@map("students")
}

model Course {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(100)
  type        String   @db.VarChar(20)
  credit      Float
  hours       Int
  semester    String   @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  teachers    CourseTeacher[]
  classes     CourseClass[]

  @@map("courses")
}

model CourseTeacher {
  id        Int      @id @default(autoincrement())
  courseId  Int      @map("course_id")
  teacherId Int      @map("teacher_id")
  createdAt DateTime @default(now()) @map("created_at")

  course    Course   @relation(fields: [courseId], references: [id])
  teacher   Teacher  @relation(fields: [teacherId], references: [id])

  @@unique([courseId, teacherId])
  @@map("course_teachers")
}

model CourseClass {
  id        Int      @id @default(autoincrement())
  courseId  Int      @map("course_id")
  classId   Int      @map("class_id")
  createdAt DateTime @default(now()) @map("created_at")

  course    Course   @relation(fields: [courseId], references: [id])
  class     Class    @relation(fields: [classId], references: [id])

  @@unique([courseId, classId])
  @@map("course_classes")
}

model Grade {
  id           Int      @id @default(autoincrement())
  studentId    Int      @map("student_id")
  courseId     Int      @map("course_id")
  semester     String   @db.VarChar(20)
  dailyScore   Float?   @map("daily_score")
  midtermScore Float?   @map("midterm_score")
  finalScore   Float?   @map("final_score")
  totalScore   Float?   @map("total_score")
  isPassed     Boolean  @default(false) @map("is_passed")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  student      Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId, semester])
  @@map("grades")
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int      @map("student_id")
  courseId  Int      @map("course_id")
  date      DateTime @db.Date
  status    String   @db.VarChar(20)
  remark    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student   Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId, date])
  @@map("attendances")
}

model OperationLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  action    String   @db.VarChar(50)
  module    String   @db.VarChar(50)
  detail    String?  @db.Text
  ip        String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("operation_logs")
}